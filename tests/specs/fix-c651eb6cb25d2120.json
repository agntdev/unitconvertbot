[
  {
    "name": "/c2f converts 100C to F",
    "steps": [
      {
        "send": { "text": "/c2f 100" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "212.00" } }
        ]
      }
    ]
  },
  {
    "name": "/c2f with no argument shows usage",
    "steps": [
      {
        "send": { "text": "/c2f" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Usage: /c2f <celsius>" } }
        ]
      }
    ]
  },
  {
    "name": "/c2f with invalid input shows error",
    "steps": [
      {
        "send": { "text": "/c2f abc" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Please provide a valid number." } }
        ]
      }
    ]
  },
  {
    "name": "/f2c converts 32F to C",
    "steps": [
      {
        "send": { "text": "/f2c 32" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "0.00" } }
        ]
      }
    ]
  },
  {
    "name": "/f2c with no argument shows usage",
    "steps": [
      {
        "send": { "text": "/f2c" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Usage: /f2c <fahrenheit>" } }
        ]
      }
    ]
  },
  {
    "name": "/f2c with invalid input shows error",
    "steps": [
      {
        "send": { "text": "/f2c abc" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Please provide a valid number." } }
        ]
      }
    ]
  },
  {
    "name": "/km2mi converts 10 km to miles",
    "steps": [
      {
        "send": { "text": "/km2mi 10" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "6.21" } }
        ]
      }
    ]
  },
  {
    "name": "/km2mi with no argument shows usage",
    "steps": [
      {
        "send": { "text": "/km2mi" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Usage: /km2mi <kilometers>" } }
        ]
      }
    ]
  },
  {
    "name": "/km2mi with invalid input shows error",
    "steps": [
      {
        "send": { "text": "/km2mi abc" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Please provide a valid number." } }
        ]
      }
    ]
  }
]