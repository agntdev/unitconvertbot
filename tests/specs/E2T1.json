[
  {
    "name": "/num parses integer",
    "steps": [
      {
        "send": { "text": "/num 42" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "42" } }
        ]
      }
    ]
  },
  {
    "name": "/num parses comma as decimal",
    "steps": [
      {
        "send": { "text": "/num 3,14" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "3.14" } }
        ]
      }
    ]
  },
  {
    "name": "/num parses first token only",
    "steps": [
      {
        "send": { "text": "/num 10.5 extra text" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "10.5" } }
        ]
      }
    ]
  },
  {
    "name": "/num with no argument shows usage",
    "steps": [
      {
        "send": { "text": "/num" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Usage: /num <number>" } }
        ]
      }
    ]
  },
  {
    "name": "/num with invalid input shows error",
    "steps": [
      {
        "send": { "text": "/num abc" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Please provide a valid number." } }
        ]
      }
    ]
  }
]